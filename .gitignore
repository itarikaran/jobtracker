
# ==========================================
# JobTracker - Root Git Ignore
# ==========================================

# ---------- Java / Maven / Spring Boot ----------
**/target/
**/HELP.md

# Maven Wrapper
**/.mvn/wrapper/maven-wrapper.jar

# Java compiled files
*.class
*.jar
*.war
*.ear

# ---------- React / Node.js / Vite ----------
**/node_modules/
**/dist/
**/dist-ssr/
**/*.local

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ---------- Environment variables / Secrets ----------
.env
.env.*
!.env.example

# ---------- IntelliJ IDEA ----------
**/.idea/
*.iml
*.iws
*.ipr

# ---------- VS Code ----------
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json

# ---------- Eclipse / Spring Tool Suite ----------
**/.classpath
**/.project
**/.settings/
**/.factorypath
**/.apt_generated/
**/.springBeans
**/.sts4-cache/

# ---------- NetBeans ----------
**/nbproject/private/
**/nbbuild/
**/nbdist/
**/.nb-gradle/

# ---------- Operating system ----------
.DS_Store
Thumbs.db
Desktop.ini
